# DataSentry 本地配置。
#
# 用法：复制成 .env（不是 .env.example），填好需要的项。
# .env 已在 .gitignore 里，不会进版本库。
# shell 里显式设置的环境变量优先于本文件。

# ── 模型 ─────────────────────────────────────────────────────────
# 三种可选：
#   mock              = 确定性规划器，按 Skill 的 plan.yaml 执行，不调用模型、不花钱（默认）
#   anthropic         = Claude
#   openai-compatible = OpenAI 兼容协议（千问 / DeepSeek / Moonshot / vLLM / Ollama）
DATASENTRY_MODEL_PROVIDER=mock

# —— pi（pi-ai 统一 provider 层）——
# 目录里有 42 个 provider，切换只改 piProvider：
# DATASENTRY_MODEL_PROVIDER=pi
# DATASENTRY_PI_PROVIDER=anthropic          # 或 openai / deepseek / moonshotai / qwen-token-plan …
# DATASENTRY_MODEL_NAME=claude-opus-5-5     # 必须是该 provider 目录里的模型 id
# DATASENTRY_MODEL_API_KEY=sk-ant-...
#
# 目录里没有的端点（比如标准 DashScope）用「自定义 provider」：
# DATASENTRY_MODEL_PROVIDER=pi
# DATASENTRY_PI_PROVIDER=dashscope
# DATASENTRY_MODEL_NAME=qwen-plus
# DATASENTRY_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DATASENTRY_MODEL_API_KEY=sk-...
#
# 注意：pi 内置的千问 provider（qwen-token-plan）指向订阅制端点
# token-plan.*.maas.aliyuncs.com，和标准 DashScope key 不通用。

# —— Agent 循环 ——
# legacy = 我们自己的 AgentRunner（默认，逐步骤执行）
# pi     = pi-agent-core 的 Agent，权限链挂在 beforeToolCall 上
# DATASENTRY_AGENT_LOOP=pi

# —— 千问（DashScope）——
# 端点与模型名有默认值（qwen-plus + 阿里云兼容端点），只填 key 就能用：
# DATASENTRY_MODEL_PROVIDER=openai-compatible
# DATASENTRY_MODEL_API_KEY=sk-...            # DashScope 的 key
# DATASENTRY_MODEL_NAME=qwen-plus            # 想要更强的可改 qwen-max
# DATASENTRY_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   国际站：https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# —— Claude ——
# DATASENTRY_MODEL_PROVIDER=anthropic
# DATASENTRY_MODEL_API_KEY=sk-ant-...

# 通用可选
# DATASENTRY_MODEL_MAX_TOKENS=16000
# DATASENTRY_MODEL_EFFORT=high          # 仅 Claude 的当前模型生效
# DATASENTRY_MODEL_THINKING=true        # 仅 Claude 的当前模型生效
# DATASENTRY_MODEL_DEBUG=0              # 设成 1 会打印每次调用的 token 用量
#
# 注意：如果你用自己的 DATASENTRY_MODEL_API_KEY，就不会继承 shell 里的
# ANTHROPIC_BASE_URL（避免「用我的 key 打到别人的代理上」）。
# 只有在用 ANTHROPIC_API_KEY 时才会连带使用 ANTHROPIC_BASE_URL。

# ── 登录 ─────────────────────────────────────────────────────────
# 首次启动（账号表为空）时用这两项创建初始账号 admin / analyst。
# 不填则使用内置默认口令（datasentry-admin / datasentry-analyst），启动日志会告警；
# NODE_ENV=production 时不填会直接启动失败——不给默认口令留后门。
# 注意：只在「账号表为空」时生效。已有账号后改这里不会改口令。
# DATASENTRY_ADMIN_PASSWORD=change-me-admin
# DATASENTRY_ANALYST_PASSWORD=change-me-analyst

# 业务用户被授权的 Workspace（逗号分隔）。不填则只授权「第一个」Workspace。
# 只在授权表为空时生效；已有授权后改这里不会覆盖。
# DATASENTRY_ANALYST_WORKSPACES=group-finance,retail-analytics

# 审批角色（逗号分隔）。Workspace 的 approvalPolicy 按这些名字判定资格。
# 不填则用内置默认值；同样只在「全员角色都为空」时生效。
# DATASENTRY_ADMIN_APPROVER_ROLES=cfo,finance-approver,team-lead
# DATASENTRY_ANALYST_APPROVER_ROLES=finance-approver,team-lead

# 部署在反向代理（nginx / 网关）之后时设为 1，登录审计才会记录真实来源 IP。
# 直接用 node 对外提供服务时不要开——否则客户端可以伪造 X-Forwarded-For。
# DATASENTRY_TRUST_PROXY=1

# ── 邮件投递（发布渠道 email）───────────────────────────────────
# smtp   = 真的连 SMTP 服务器发出去（默认）
# stream = 只组装报文落盘，不联网（测试用）
# 开发期不需要真邮箱：另开终端跑 `npm run mail`，邮件会落到 data/mail/
# DATASENTRY_SMTP_MODE=smtp
# DATASENTRY_SMTP_HOST=127.0.0.1
# DATASENTRY_SMTP_PORT=1025
# DATASENTRY_SMTP_SECURE=0
# DATASENTRY_SMTP_USER=
# DATASENTRY_SMTP_PASS=
# DATASENTRY_SMTP_FROM=datasentry@example.com

# ── IM 投递（企业微信群机器人）─────────────────────────────────
# 目标名与凭据变量名在 workspace.json 的 imTargets 里声明，密钥只放这里：
# DATASENTRY_CRED_WECOM_BOARD_ROOM=webhook-key
# 本地验证：先跑 `npm run im`，再把地址指过去
# DATASENTRY_IM_BASE_URL=http://127.0.0.1:1026

# ── 经营报表库（Postgres）───────────────────────────────────────
# 不填则用内嵌 PGlite（Postgres 的 WASM 构建），数据落在 data/pg。
# 填了就连接真实 Postgres 服务。
# DATASENTRY_PG_URL=postgres://user:pass@host:5432/reporting

# ── 运行环境 ─────────────────────────────────────────────────────
# PORT=3000
# HOST=127.0.0.1
# DATASENTRY_DATA_DIR=                  # 重定向运行期数据目录（回归/测试用）
